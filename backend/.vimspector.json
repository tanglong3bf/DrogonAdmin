{
  "configurations": {
    "Launch": {
      "adapter": "vscode-cpptools",
      "filetypes": ["cpp"],
      "configuration": {
        "request": "launch",
        "program": "./build/DrogonAdminBackend",
        "stopAtEntry": true,
        "MIMode": "gdb",
        "setupCommands": [
          {
            "description": "enable mi pretty‑printing",
            "text": "-enable-pretty-printing",
            "ignoreFailures": false
          }
        ]
      }
    }
  }
}
