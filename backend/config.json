{
  "listeners": [
    {
      //address: Ip address,0.0.0.0 by default
      "address": "0.0.0.0",
      //port: Port number
      "port": 8000,
      //https: If true, use https for security,false by default
      "https": false
    }
  ],
  "db_clients": [
    {
      //name: Name of the client,'default' by default
      "name": "default",
      //rdbms: Server type, postgresql,mysql or sqlite3, "postgresql" by default
      "rdbms": "postgresql",
      //host: Server address,localhost by default
      "host": "127.0.0.1",
      //port: Server port, 5432 by default
      "port": 5432,
      //dbname: Database name
      "dbname": "drogon_admin_db",
      //user: 'postgres' by default
      "user": "admin",
      //passwd: '' by default
      "passwd": "123456",
      //is_fast: false by default, if it is true, the client is faster but user can't call
      //any synchronous interface of it.
      "is_fast": false,
      //client_encoding: The character set used by the client. it is empty string by default which
      //means use the default character set.
      "client_encoding": "utf8",
      //number_of_connections: 1 by default, if the 'is_fast' is true, the number is the number of
      //connections per IO thread, otherwise it is the total number of all connections.
      "number_of_connections": 1,
      //timeout: -1.0 by default, in seconds, the timeout for executing a SQL query.
      //zero or negative value means no timeout.
      "timeout": 10,
      //auto_batch: this feature is only available for the PostgreSQL driver(version >= 14.0), see
      //the wiki for more details.
      "auto_batch": false
      //connect_options: extra options for the connection. Only works for PostgreSQL now.
      //For more information, see https://www.postgresql.org/docs/16/libpq-connect.html#LIBPQ-CONNECT-OPTIONS
      //"connect_options": { "statement_timeout": "1s" }
    }
  ],
  /*"redis_clients": [
    {
      //name: Name of the client,'default' by default
      "name": "default",
      //host: Server IP, 127.0.0.1 by default
      "host": "127.0.0.1",
      //port: Server port, 6379 by default
      "port": 6379,
      //username: '' by default which means 'default' in redis ACL
      "username": "",
      //passwd: '' by default
      "passwd": "",
      //db index: 0 by default
      "db": 0,
      //is_fast: false by default, if it is true, the client is faster but user can't call
      //any synchronous interface of it.
      "is_fast": false,
      //number_of_connections: 1 by default, if the 'is_fast' is true, the number is the number of  
      //connections per IO thread, otherwise it is the total number of all connections.  
      "number_of_connections": 1,
      //timeout: -1.0 by default, in seconds, the timeout for executing a command.
      //zero or negative value means no timeout.
      "timeout": -1.0
    }
  ],*/
  "app": {
    //number_of_threads: The number of IO threads, 1 by default, if the value is set to 0, the number of threads
    //is the number of CPU cores
    "number_of_threads": 1,
    //enable_session: False by default
    "enable_session": false,
    "session_timeout": 0,
    //string value of SameSite attribute of the Set-Cookie HTTP response header
    //valid value is either 'Null' (default), 'Lax', 'Strict' or 'None'
    "session_same_site": "Null",
    //session_cookie_key: The cookie key of the session, "JSESSIONID" by default
    "session_cookie_key": "JSESSIONID",
    //session_max_age: The max age of the session cookie, -1 by default
    "session_max_age": -1,
    //document_root: Root path of HTTP document, default path is ./
    "document_root": "./",
    //home_page: Set the HTML file of the home page, the default value is "index.html"
    //If there isn't any handler registered to the path "/", the home page file in the "document_root" is send to clients as a response
    //to the request for "/".
    "home_page": "index.html",
    //use_implicit_page: enable implicit pages if true, true by default
    "use_implicit_page": true,
    //implicit_page: Set the file which would the server access in a directory that a user accessed.
    //For example, by default, http://localhost/a-directory resolves to http://localhost/a-directory/index.html.
    "implicit_page": "index.html",
    //static_file_headers: Headers for static files
    /*"static_file_headers": [
            {
                "name": "field-name",
                "value": "field-value"
            }
        ],*/
    //upload_path: The path to save the uploaded file. "uploads" by default.
    //If the path isn't prefixed with /, ./ or ../,
    //it is relative path of document_root path
    "upload_path": "uploads",
    /* file_types:
     * HTTP download file types,The file types supported by drogon
     * by default are "html", "js", "css", "xml", "xsl", "txt", "svg",
     * "ttf", "otf", "woff2", "woff" , "eot", "png", "jpg", "jpeg",
     * "gif", "bmp", "ico", "icns", etc. */
    "file_types": [
      "gif",
      "png",
      "jpg",
      "js",
      "css",
      "html",
      "ico",
      "swf",
      "xap",
      "apk",
      "cur",
      "xml",
      "webp",
      "svg"
    ],
    // mime: A dictionary that extends the internal MIME type support. Maps extensions into new MIME types
    // note: This option only adds MIME to the sever. `file_types` above have to be set for the server to serve them.
    "mime": {
      // "text/markdown": "md",
      // "text/gemini": ["gmi", "gemini"]
    },
    //locations: An array of locations of static files for GET requests.
    "locations": [
      {
        //uri_prefix: The URI prefix of the location prefixed with "/", the default value is "" that disables the location.
        //"uri_prefix": "/.well-known/acme-challenge/",
        //default_content_type: The default content type of the static files without
        //an extension. empty string by default.
        "default_content_type": "text/plain",
        //alias: The location in file system, if it is prefixed with "/", it
        //presents an absolute path, otherwise it presents a relative path to
        //the document_root path.
        //The default value is "" which means use the document root path as the location base path.
        "alias": "",
        //is_case_sensitive: indicates whether the URI prefix is case sensitive.
        "is_case_sensitive": false,
        //allow_all: true by default. If it is set to false, only static files with a valid extension can be accessed.
        "allow_all": true,
        //is_recursive: true by default. If it is set to false, files in sub directories can't be accessed.
        "is_recursive": true,
        //filters: string array, the filters applied to the location.
        "filters": []
      }
    ],
    //max_connections: maximum number of connections, 100000 by default
    "max_connections": 100000,
    //max_connections_per_ip: maximum number of connections per client, 0 by default which means no limit
    "max_connections_per_ip": 0,
    //Load_dynamic_views: False by default, when set to true, drogon
    //compiles and loads dynamically "CSP View Files" in directories defined
    //by "dynamic_views_path"
    "load_dynamic_views": false,
    //dynamic_views_path: If the path isn't prefixed with /, ./ or ../,
    //it is relative path of document_root path
    "dynamic_views_path": ["./views"],
    //dynamic_views_output_path: Default by an empty string which means the output path of source
    //files is the path where the csp files locate. If the path isn't prefixed with /, it is relative
    //path of the current working directory.
    "dynamic_views_output_path": "",
    //json_parser_stack_limit: 1000 by default, the maximum number of stack depth when reading a json string by the jsoncpp library.
    "json_parser_stack_limit": 1000,
    //enable_unicode_escaping_in_json: true by default, enable unicode escaping in json.
    "enable_unicode_escaping_in_json": true,
    //float_precision_in_json: set precision of float number in json.
    "float_precision_in_json": {
      //precision: 0 by default, 0 means use the default precision of the jsoncpp lib.
      "precision": 0,
      //precision_type: must be "significant" or "decimal", defaults to "significant" that means
      //setting max number of significant digits in string, "decimal" means setting max number of
      //digits after "." in string
      "precision_type": "significant"
    },
    //log: Set log output, drogon output logs to stdout by default
    "log": {
      //use_spdlog: Use spdlog library to log
      "use_spdlog": false,
      //log_path: Log file path,empty by default,in which case,logs are output to the stdout
      //"log_path": "./",
      //logfile_base_name: Log file base name,empty by default which means drogon names logfile as
      //drogon.log ...
      "logfile_base_name": "",
      //log_size_limit: 100000000 bytes by default,
      //When the log file size reaches "log_size_limit", the log file is switched.
      "log_size_limit": 100000000,
      //max_files: 0 by default,
      //When the number of old log files exceeds "max_files", the oldest file will be deleted. 0 means never delete.
      "max_files": 0,
      //log_level: "DEBUG" by default,options:"TRACE","DEBUG","INFO","WARN"
      //The TRACE level is only valid when built in DEBUG mode.
      "log_level": "DEBUG",
      //display_local_time: false by default, if true, the log time is displayed in local time
      "display_local_time": false
    },
    //run_as_daemon: False by default
    "run_as_daemon": false,
    //handle_sig_term: True by default
    "handle_sig_term": true,
    //relaunch_on_error: False by default, if true, the program will be restart by the parent after exiting;
    "relaunch_on_error": false,
    //use_sendfile: True by default, if true, the program
    //uses sendfile() system-call to send static files to clients;
    "use_sendfile": true,
    //use_gzip: True by default, use gzip to compress the response body's content;
    "use_gzip": true,
    //use_brotli: False by default, use brotli to compress the response body's content;
    "use_brotli": false,
    //static_files_cache_time: 5 (seconds) by default, the time in which the static file response is cached,
    //0 means cache forever, the negative value means no cache
    "static_files_cache_time": 5,
    //simple_controllers_map: Used to configure mapping from path to simple controller
    //"simple_controllers_map": [
    //    {
    //        "path": "/path/name",
    //        "controller": "controllerClassName",
    //        "http_methods": [
    //            "get",
    //            "post"
    //        ],
    //        "filters": [
    //            "FilterClassName"
    //        ]
    //    }
    //],
    //idle_connection_timeout: Defaults to 60 seconds, the lifetime
    //of the connection without read or write
    "idle_connection_timeout": 60,
    //server_header_field: Set the 'Server' header field in each response sent by drogon,
    //empty string by default with which the 'Server' header field is set to "Server: drogon/version string\r\n"
    "server_header_field": "",
    //enable_server_header: Set true to force drogon to add a 'Server' header to each HTTP response. The default
    //value is true.
    "enable_server_header": true,
    //enable_date_header: Set true to force drogon to add a 'Date' header to each HTTP response. The default
    //value is true.
    "enable_date_header": true,
    //keepalive_requests: Set the maximum number of requests that can be served through one keep-alive connection.
    //After the maximum number of requests are made, the connection is closed.
    //The default value of 0 means no limit.
    "keepalive_requests": 0,
    //pipelining_requests: Set the maximum number of unhandled requests that can be cached in pipelining buffer.
    //After the maximum number of requests are made, the connection is closed.
    //The default value of 0 means no limit.
    "pipelining_requests": 0,
    //gzip_static: If it is set to true, when the client requests a static file, drogon first finds the compressed
    //file with the extension ".gz" in the same path and send the compressed file to the client.
    //The default value of gzip_static is true.
    "gzip_static": true,
    //br_static: If it is set to true, when the client requests a static file, drogon first finds the compressed
    //file with the extension ".br" in the same path and send the compressed file to the client.
    //The default value of br_static is true.
    "br_static": true,
    //client_max_body_size: Set the maximum body size of HTTP requests received by drogon. The default value is "1M".
    //One can set it to "1024", "1k", "10M", "1G", etc. Setting it to "" means no limit.
    "client_max_body_size": "1M",
    //max_memory_body_size: Set the maximum body size in memory of HTTP requests received by drogon. The default value is "64K" bytes.
    //If the body size of a HTTP request exceeds this limit, the body is stored to a temporary file for processing.
    //Setting it to "" means no limit.
    "client_max_memory_body_size": "64K",
    //client_max_websocket_message_size: Set the maximum size of messages sent by WebSocket client. The default value is "128K".
    //One can set it to "1024", "1k", "10M", "1G", etc. Setting it to "" means no limit.
    "client_max_websocket_message_size": "128K",
    //reuse_port: Defaults to false, users can run multiple processes listening on the same port at the same time.
    "reuse_port": false,
    // enabled_compressed_request: Defaults to false. If true the server will automatically decompress compressed request bodies.
    // Currently only gzip and br are supported. Note: max_memory_body_size and max_body_size applies twice for compressed requests.
    // Once when receiving and once when decompressing. i.e. if the decompressed body is larger than max_body_size, the request
    // will be rejected.
    "enabled_compressed_request": false,
    // enable_request_stream: Defaults to false. If true the server will enable stream mode for http requests.
    // See the wiki for more details.
    "enable_request_stream": false
  },
  //plugins: Define all plugins running in the application
  "plugins": [
    {
      "name": "drogon::plugin::AccessLogger",
      "dependencies": [],
      "config": {
        "use_spdlog": false,
        "log_path": "",
        "log_format": "",
        "log_file": "access.log",
        "log_size_limit": 0,
        "use_local_time": true,
        "log_index": 0,
        "show_microseconds": true
        // "custom_time_format": "",
        // "use_real_ip": false
      }
    },
    {
      "name": "tl::jwt::JwtUtil",
      "config": {
        // iat is MUST NOT set. It will be set in code automatically.
        "payload": {
          // exp: expired time in seconds, if it is negative, means always
          // not expired. 1800 by default.
          "exp": 86400,
          // jti: JWT ID, if it is false, means not set this field to
          // payload. If it is true, the UUID will be used to generate the
          // jti field. False by default.
          "jti": true
        }
      }
    },
    {
      "name": "tl::sql::SqlGenerator",
      "config": {
        "sqls": {
          // 获取部门树
          "get_dept_tree": {
            "main": "WITH RECURSIVE dept_ancestor AS ( @current() UNION @sub() ) SELECT * FROM dept_ancestor @order()",
            "current": "SELECT *, 0 AS \"level\" FROM sys_dept WHERE parent_id IS NULL AND deleted_by IS NULL",
            "sub": "SELECT s.*, d.\"level\" + 1 AS \"level\" FROM sys_dept s @inner_join()",
            "inner_join": "INNER JOIN dept_ancestor d ON d.dept_id = s.parent_id AND s.deleted_by IS NULL",
            "order": "ORDER BY \"level\", parent_id, sort_num, dept_id"
          },
          // 指定父部门id，获取最大的sort_num
          "get_max_sub_dept_sort_num": {
            "main": "SELECT MAX(sort_num) FROM sys_dept @condition(parent_id)",
            "condition": "WHERE deleted_by IS NULL AND parent_id @if(parent_id) = ${parent_id} @else IS NULL @endif"
          },
          // 批量更新部门数据、包括批量删除
          "multi_update_dept": {
            "main": {
              "sql": "UPDATE sys_dept d SET @sets(fields_list) FROM ( VALUES @values(data_list, fields_list) ) AS s @fields(fields_list) WHERE d.dept_id = s.dept_id AND d.version = s.version",
              "params": {
                "fields_list": [
                  "dept_id",
                  "parent_id",
                  "name",
                  "sort_num",
                  "version",
                  "created_by",
                  "created_time",
                  "updated_by",
                  "updated_time",
                  "deleted_by",
                  "deleted_time"
                ]
              }
            },
            "sets": "@for(field in fields_list, separator=',') @if(field == 'version') ${field}=d.version+1 @else ${field}=s.${field} @endif @endfor",
            "values": "(@for(item in data_list, separator='), (') ${item.dept_id}, @int_value(value = item.parent_id), '${item.name}', ${item.sort_num}, ${item.version}, ${item.created_by}, '${item.created_time}'::timestamp, ${item.updated_by}, '${item.updated_time}'::timestamp, @int_value(value = item.deleted_by), @timestamp_value(value = item.deleted_time) @endfor)",
            "int_value": "@if(value) ${value} @else NULL::Integer @endif",
            "timestamp_value": "@if(value) '${value}'::timestamp @else NULL::timestamp @endif",
            "fields": "(@for(item in fields_list, separator=',') ${item} @endfor)"
          },
          "count_belong_dept": {
            "main": "SELECT COUNT(*) FROM sys_role_dept rd LEFT JOIN sys_role r ON rd.role_id = r.role_id WHERE @condition(dept_id)",
            "condition": "r.deleted_by IS NULL AND r.relation_type = 1 AND rd.dept_id = ${dept_id} "
          },
          "get_excluding_dept_by_dept_id": {
            "main": "SELECT rd.* FROM sys_role_dept rd LEFT JOIN sys_role r ON rd.role_id = r.role_id WHERE @condition(dept_id)",
            "condition": "r.deleted_by IS NULL AND r.relation_type = 2 AND rd.dept_id = ${dept_id} "
          },
          "count_role_by_name_and_dept_id": {
            "main": "@if(dept_id) SELECT COUNT(*) FROM (@includedRoles(name, dept_id) UNION @excludedRoles(name, dept_id) UNION @normalRoles(name)) @else @allRoles(name) @endif",
            "allRoles": "SELECT COUNT(*) FROM sys_role r @condition(name)",
            "normalRoles": "@baseQuery(name, type='0')",
            "includedRoles": "SELECT r.* FROM sys_role r @innerJoin(dept_id) @condition(name, type='1')",
            "excludedRoles": "@baseQuery(name, dept_id, type='2')",
            "baseQuery": "SELECT r.* FROM sys_role r @condition(name, dept_id, type)",
            "innerJoin": "INNER JOIN sys_role_dept rd ON r.role_id = rd.role_id AND rd.dept_id = ${dept_id}",
            "condition": "WHERE r.deleted_by IS NULL @if(name) AND name LIKE '%${name}%' @endif @if(type) AND r.relation_type = ${type} @endif @noBindDept(type, dept_id)",
            "noBindDept": "@if(type=='0'||type=='2') AND r.role_id NOT IN (@subQuery(dept_id)) @endif",
            "subQuery": "SELECT DISTINCT role_id FROM sys_role_dept @if(dept_id) WHERE dept_id = ${dept_id} @endif"
          },
          "get_role_list": {
            "main": "@if(dept_id) SELECT * FROM (@normalRoles(name) UNION @includedRoles(name, dept_id) UNION @excludedRoles(name, dept_id)) @else @allRoles(name) @endif ORDER BY role_id ASC LIMIT ${limit} @if(offset != 0) OFFSET ${offset} @endif",
            "allRoles": "SELECT * FROM sys_role r @condition(name)",
            "normalRoles": "@baseQuery(name, type='0')",
            "includedRoles": "SELECT r.* FROM sys_role r @innerJoin(dept_id) @condition(name, type='1')",
            "excludedRoles": "@baseQuery(name, dept_id, type='2')",
            "baseQuery": "SELECT r.* FROM sys_role r @condition(name, dept_id, type)",
            "innerJoin": "INNER JOIN sys_role_dept rd ON r.role_id = rd.role_id AND rd.dept_id = ${dept_id}",
            "condition": "WHERE r.deleted_by IS NULL @if(name) AND name LIKE '%${name}%' @endif @if(type) AND r.relation_type = ${type} @endif @noBindDept(type, dept_id)",
            "noBindDept": "@if(type=='0'||type=='2') AND r.role_id NOT IN (@subQuery(dept_id)) @endif",
            "subQuery": "SELECT DISTINCT role_id FROM sys_role_dept @if(dept_id) WHERE dept_id = ${dept_id} @endif"
          },
          "update_role": {
            "main": "UPDATE sys_role SET name = @string_value(value = data.name), code = @string_value(value = data.code), description = @string_value(value = data.description), quota_type = ${data.quota_type}, user_quota = @int_value(value = data.user_quota),  relation_type = ${data.relation_type}, version = version + 1, updated_by = ${data.updated_by}, updated_time = '${data.updated_time}'::timestamp WHERE role_id = ${data.role_id} AND version = ${data.version}",
            "string_value": "@if(value) '${value}' @else NULL @endif",
            "int_value": "@if(value) ${value} @else NULL::Integer @endif"
          },
          "multi_insert_role_dept": {
            "main": {
              "sql": "INSERT INTO sys_role_dept (@for(field in fields, separator=',') ${field} @endfor) VALUES @values(data)",
              "params": {
                "fields": ["role_id", "dept_id", "created_by", "created_time"]
              }
            },
            "values": "(@for(item in data, separator='), (') ${item.role_id}, ${item.dept_id}, ${item.created_by}, '${item.created_time}'::timestamp @endfor)"
          },
          "multi_delete_role_dept": {
            "main": "DELETE FROM \"sys_role_dept\" WHERE (role_id, dept_id) IN ( VALUES @values(data) )",
            "values": "(@for(item in data, separator='), (') ${item.role_id}, ${item.dept_id} @endfor)"
          },
          "update_user": {
            "main": "UPDATE sys_user SET nickname='${data.nickname}', avatar='${data.avatar}', sex=${data.sex}, dept_id=@int_value(value=data.dept_id), phone_number=@string_value(value=data.phone_number), email=@string_value(value=data.email), status=${data.status}, version = version + 1, updated_by = ${data.updated_by}, updated_time = '${data.updated_time}'::timestamp WHERE user_id = ${data.user_id} AND version = ${data.version}",
            "string_value": "@if(value) '${value}' @else NULL @endif",
            "int_value": "@if(value) ${value} @else NULL::Integer @endif"
          },
          "multi_insert_user_role": {
            "main": {
              "sql": "INSERT INTO sys_user_role (@for(field in fields, separator=',') ${field} @endfor) VALUES @values(data)",
              "params": {
                "fields": ["user_id", "role_id", "created_by", "created_time"]
              }
            },
            "values": "(@for(item in data, separator='), (') ${item.user_id}, ${item.role_id}, ${item.created_by}, '${item.created_time}'::timestamp @endfor)"
          },
          "multi_delete_user_role": {
            "main": "DELETE FROM \"sys_user_role\" WHERE (user_id, role_id) IN ( VALUES @values(data) )",
            "values": "(@for(item in data, separator='), (') ${item.user_id}, ${item.role_id} @endfor)"
          },
          "get_assignable_roles": {
            "main": "SELECT DISTINCT r.role_id, r.name, r.version FROM public.sys_role r @where()",
            "where": "WHERE r.deleted_by IS NULL AND (r.relation_type = 0 OR (@sub_query(type = '1')) OR (@sub_query(type = '2')))",
            "sub_query": {
              "sql": "r.relation_type = ${type} AND @if(type == '2') NOT @endif EXISTS ( SELECT 1 FROM public.sys_role_dept rd WHERE rd.role_id = r.role_id AND rd.dept_id = ${emm})",
              "params": { "emm": "$1" }
            }
          },
          "count_user_by_dept_and_roles": {
            "main": "SELECT COUNT(*) AS used_count, ur.role_id AS role_id FROM sys_user u @inner_join() @where(dept_id, role_ids) @group_and_order()",
            "inner_join": "INNER JOIN sys_user_role ur ON u.user_id = ur.user_id",
            "where": "WHERE u.dept_id = ${dept_id} @if(role_ids.length) AND ur.role_id IN @id_list(role_ids) @endif",
            "id_list": "(@for(id in role_ids, separator=',') ${id} @endfor)",
            "group_and_order": "GROUP BY ur.role_id ORDER BY ur.role_id"
          },
          "get_dept_ids_by_role_id": {
            "main": "SELECT DISTINCT u.dept_id FROM sys_user u LEFT JOIN sys_user_role ur ON u.user_id = ur.user_id @where(role_id) ORDER BY u.dept_id",
            "where": "WHERE u.deleted_by = NULL AND ur.role_id = ${role_id}"
          },
          "count_users_with_role_per_department": {
            "main": "SELECT @fields() FROM public.sys_user u @inner_join() WHERE ur.role_id = ${role_id} GROUP BY u.dept_id ORDER BY u.dept_id",
            "fields": "u.dept_id, COUNT(*) AS user_count",
            "inner_join": "INNER JOIN public.sys_user_role ur ON u.user_id = ur.user_id"
          },
          "count_user_by_role_not_in_depts": {
            "main": "SELECT COUNT(*) FROM sys_user u @inner_join(role_id) @where(dept_ids)",
            "inner_join": "INNER JOIN sys_user_role ur ON u.user_id = ur.user_id AND ur.role_id = ${role_id}",
            "where": "WHERE (u.dept_id IS NULL OR u.dept_id NOT IN @id_list(dept_ids))",
            "id_list": "(@for(id in dept_ids, separator=',') ${id} @endfor)"
          },
          "count_user_by_role_in_depts": {
            "main": "SELECT COUNT(*) FROM sys_user u @inner_join(role_id) @where(dept_ids)",
            "inner_join": "INNER JOIN sys_user_role ur ON u.user_id = ur.user_id AND ur.role_id = ${role_id}",
            "where": "WHERE (u.dept_id IS NULL OR u.dept_id IN @id_list(dept_ids))",
            "id_list": "(@for(id in dept_ids, separator=',') ${id} @endfor)"
          },
          "count_users_per_role_in_department": {
            "main": "SELECT ur.role_id AS role_id, COUNT(u) user_count FROM sys_user u RIGHT JOIN sys_user_role ur ON u.user_id = ur.user_id @if(role_ids.length) AND ur.role_id IN (@for(id in role_ids, separator=',') ${id} @endfor) @endif WHERE u.deleted_by IS NULL AND u.dept_id = ${dept_id} GROUP BY ur.role_id"
          },
          "count_user_by_role_list": {
            "main": "SELECT COUNT(u.*) used_count, ur.role_id FROM sys_user u @inner_join() @where(role_ids) @group()",
            "inner_join": "INNER JOIN sys_user_role ur ON u.user_id = ur.user_id",
            "where": "WHERE u.deleted_by IS NULL @if(role_ids.length) AND ur.role_id IN @id_list(role_ids) @endif",
            "id_list": "(@for(id in role_ids, separator=',') ${id} @endfor)",
            "group": "GROUP BY ur.role_id"
          },
          // 获取模块树、功能、功能优先级
          "get_module_tree": {
            "main": "WITH RECURSIVE module_ancestor AS (@anchor() UNION @recursive()) @select_tree()",
            "anchor": "SELECT *, 0 AS \"level\" FROM sys_module WHERE parent_id IS NULL AND deleted_by IS NULL",
            "recursive": "SELECT s.*, d.\"level\" + 1 AS \"level\" FROM sys_module s INNER JOIN module_ancestor d ON d.module_id = s.parent_id AND s.deleted_by IS NULL",
            "select_tree": "SELECT m.*, @sub_action_list(), @sub_priority_list() FROM module_ancestor m ORDER BY m.\"level\", m.parent_id, m.sort_num, m.module_id",
            "sub_action_list": "(SELECT json_agg(a ORDER BY a.sort_num, a.action_id) FROM sys_action a WHERE a.module_id = m.module_id AND a.deleted_by IS NULL) AS action_list",
            "sub_priority_list": "(SELECT json_agg(ap ORDER BY ap.high_id, ap.low_id) FROM sys_action_priority ap WHERE ap.module_id = m.module_id) AS priority_list"
          },
          // 指定父模块id，获取最大的sort_num
          "get_max_sub_module_sort_num": {
            "main": "SELECT MAX(sort_num) FROM sys_module @condition(parent_id)",
            "condition": "WHERE deleted_by IS NULL AND parent_id @if(parent_id) = ${parent_id} @else IS NULL @endif"
          },
          "update_module": {
            "main": "UPDATE sys_module SET @sets(data) WHERE module_id = ${data.module_id} AND version = ${data.version}",
            "sets": "name = '${data.name}', description = @string_value(value=data.description), sort_num = ${data.sort_num}, parent_id = ${data.parent_id}, version = version + 1, updated_by = ${data.updated_by}, updated_time = '${data.updated_time}'::timestamp",
            "string_value": "@if(value) '${value}' @else NULL @endif"
          },
          // 批量更新模块数据、包括批量删除
          "multi_update_module": {
            "main": {
              "sql": "UPDATE sys_module m SET @sets(fields_list) FROM ( VALUES @values(data_list, fields_list) ) AS s @fields(fields_list) WHERE m.module_id = s.module_id",
              "params": {
                "fields_list": [
                  "module_id",
                  "name",
                  "description",
                  "sort_num",
                  "parent_id",
                  "version",
                  "created_by",
                  "created_time",
                  "updated_by",
                  "updated_time",
                  "deleted_by",
                  "deleted_time"
                ]
              }
            },
            "sets": "@for(field in fields_list, separator=',') @if(field == 'version') ${field}=m.version+1 @else ${field}=s.${field} @endif @endfor",
            "values": "(@for(item in data_list, separator='), (') ${item.module_id}, '${item.name}', @string_value(value = item.description), ${item.sort_num}, @int_value(value = item.parent_id), ${item.version}, ${item.created_by}, '${item.created_time}'::timestamp, ${item.updated_by}, '${item.updated_time}'::timestamp, @int_value(value = item.deleted_by), @timestamp_value(value = item.deleted_time) @endfor)",
            "string_value": "@if(value) '${value}' @else NULL @endif",
            "int_value": "@if(value) ${value} @else NULL::Integer @endif",
            "timestamp_value": "@if(value) '${value}'::timestamp @else NULL::timestamp @endif",
            "fields": "(@for(item in fields_list, separator=',') ${item} @endfor)"
          },
          // 批量插入功能
          "multi_insert_action": {
            "main": {
              "sql": "INSERT INTO sys_action (@for(field in fields, separator=',') ${field} @endfor) VALUES @values(data) RETURNING action_id",
              "params": {
                "fields": [
                  "name",
                  "code",
                  "description",
                  "sort_num",
                  "has_data_permission",
                  "module_id",
                  "created_by",
                  "created_time",
                  "updated_by",
                  "updated_time"
                ]
              }
            },
            "values": "(@for(item in data, separator='), (') '${item.name}', '${item.code}', @string_value(value = item.description), ${item.sort_num}, ${item.has_data_permission}, ${item.module_id}, ${item.created_by}, '${item.created_time}'::timestamp, ${item.updated_by}, '${item.updated_time}'::timestamp @endfor)",
            "string_value": "@if(value) '${value}' @else NULL @endif"
          },
          // 批量更新功能，包括软删除
          "multi_update_action": {
            "main": {
              "sql": "UPDATE sys_action a SET @sets(fields_list) FROM ( VALUES @values(data, fields_list) ) AS s @fields(fields_list) WHERE a.action_id = s.action_id",
              "params": {
                "fields_list": [
                  "action_id",
                  "name",
                  "code",
                  "description",
                  "sort_num",
                  "has_data_permission",
                  "module_id",
                  "created_by",
                  "created_time",
                  "updated_by",
                  "updated_time",
                  "deleted_by",
                  "deleted_time"
                ]
              }
            },
            "sets": "@for(field in fields_list, separator=',') ${field} = s.${field} @endfor",
            "values": "(@for(item in data, separator='), (') ${item.action_id}, '${item.name}', '${item.code}', @string_value(value = item.description), ${item.sort_num}, ${item.has_data_permission}, ${item.module_id}, ${item.created_by}, '${item.created_time}'::timestamp, ${item.updated_by}, '${item.updated_time}'::timestamp, @int_value(value = item.deleted_by), @timestamp_value(value = item.deleted_time) @endfor)",
            "string_value": "@if(value) '${value}' @else NULL @endif",
            "int_value": "@if(value) ${value} @else NULL::Integer @endif",
            "timestamp_value": "@if(value) '${value}'::timestamp @else NULL::timestamp @endif",
            "fields": "(@for(item in fields_list, separator=',') ${item} @endfor)"
          },
          // 批量插入功能优先级
          "multi_insert_priority": {
            "main": {
              "sql": "INSERT INTO sys_action_priority (@for(field in fields, separator=',') ${field} @endfor) VALUES @values(data)",
              "params": {
                "fields": [
                  "high_id",
                  "low_id",
                  "module_id",
                  "created_by",
                  "created_time"
                ]
              }
            },
            "values": "(@for(item in data, separator='), (') ${item.high_id}, ${item.low_id}, ${item.module_id}, ${item.created_by}, '${item.created_time}'::timestamp @endfor)"
          },
          // 批量删除功能优先级
          "multi_delete_priority": {
            "main": "DELETE FROM sys_action_priority WHERE (high_id, low_id) IN ( VALUES @values(data) )",
            "values": "(@for(item in data, separator='), (') ${item.high_id}, ${item.low_id} @endfor)"
          }
        }
      }
    },
    {
      // 纯头文件插件，未被使用时可能会报错，无影响
      "name": "tl::sql::RelationQuery"
    }
